# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# GROQ_API_KEY: Required for Groq LPU fast inference
GROQ_API_KEY=

# OLLAMA_API_KEY: Required for Ollama Cloud API access
OLLAMA_API_KEY=

# KIMI_API_KEY: Required for Moonshot AI / Kimi API access
KIMI_API_KEY=

# OLLAMA_BASE_URL: Base URL for Ollama service (defaults to https://ollama.com if cloud)
OLLAMA_BASE_URL=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GitHub OAuth and Personal Access Token (PAT) for Real GitHub Connect
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
